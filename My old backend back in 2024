def post_to_discord(webhook_url, payload):
    try:
        requests.post(webhook_url, json=payload, timeout=5)
    except Exception as e:
        print(f"[discord webhook error] {e}")


def execute_cloud_script(playfab_id, func_name, func_params=None):
    resp = requests.post(
        url=GameConfig.playfab_url("Server/ExecuteCloudScript"),
        json={
            "PlayFabId": playfab_id,
            "FunctionName": func_name,
            "FunctionParameter": func_params or {},
        },
        headers=GameConfig.auth_headers(),
    )

    if resp.status_code == 200:
        result = resp.json().get("data", {}).get("FunctionResult", {})
        return jsonify(result), 200
    return jsonify({}), resp.status_code


def caller_id_from_request(data):
    return (
        data.get("FunctionParameter", {})
            .get("CallerEntityProfile", {})
            .get("Lineage", {})
            .get("TitlePlayerAccountId")
    )


def validate_nonce(nonce, org_scoped_id=None):
    return isinstance(nonce, str) and len(nonce) == 16


def check_oculus_nonce(nonce, oculus_id):
    resp = requests.post(
        url=f"https://graph.oculus.com/user_nonce_validate?nonce={nonce}&user_id={oculus_id}",
        headers={"content-type": "application/json"},
    )
    return resp.json().get("is_valid", False)

