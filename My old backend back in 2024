@app.route("/api/Vote", methods=["POST"])
def vote():
    data = request.get_json()
    if not data:
        return jsonify({"message": "Missing request body"}), 400

    poll_id = data.get("pollId")
    playfab_id = data.get("playFabId")
    oculus_id = data.get("oculusId")
    user_nonce = data.get("userNonce")
    platform = data.get("userPlatform")
    option_index = data.get("optionIndex")
    is_pred = data.get("isPrediction")
    ticket = data.get("playFabTicket")
    app_version = data.get("appVersion", "unknown")

    poll = next((p for p in active_polls if p["pollId"] == poll_id), None)
    if not poll:
        return jsonify({"message": "Poll not found"}), 404

    post_to_discord(GameConfig.voting_webhook, {
        "embeds": [{
            "title": "A player voted",
            "description": (
                f"**Question:** {poll['question']}\n"
                f"**Voted for:** {poll['voteOptions'][option_index]}\n"
                f"**Prediction:** {is_pred}\n"
                f"**Poll id:** {poll_id}\n\n"
                f"**Player id:** {playfab_id}\n"
                f"**Oculus id:** {oculus_id}\n"
                f"**Platform:** {platform}\n"
                f"**Session ticket:** {ticket}\n"
                f"**Nonce:** {user_nonce}\n"
                f"**App version:** {app_version}\n"
                f"**Title id:** {GameConfig.title_id}"
            ),
            "color": 63488,
        }]
    })

    return jsonify({"message": "Vote recorded successfully"}), 200


@app.route("/api/old/PF", methods=["POST"])
def playfab_authentication():
    data = request.get_json() or {}
    required = ["CustomId", "Nonce", "AppId", "Platform", "OculusId"]
    missing  = [f for f in required if not data.get(f)]

    if missing:
        return jsonify({
            "message": f"Missing field(s): {', '.join(missing)}",
            "error":   f"BadRequest-No{missing[0]}",
        }), 400

    if data["AppId"] != GameConfig.title_id:
        return jsonify({"message": "App id mismatch", "error": "BadRequest-AppIdMismatch"}), 400

    if not data["CustomId"].startswith(("OC", "PI")):
        return jsonify({"message": "Custom id must start with OC or PI", "error": "BadRequest-NoOCorPIPrefix"}), 400

    login = requests.post(
        url=GameConfig.playfab_url("Server/LoginWithServerCustomId"),
        json={"ServerCustomId": data["CustomId"], "CreateAccount": True},
        headers=GameConfig.auth_headers(),
    )

    if login.status_code != 200:
        err = login.json().get("errorDetails", {})
        first = next(iter(err), "UnknownError")
        return jsonify({"errorMessage": first, "errorDetails": err.get(first)}), login.status_code

    login_data = login.json()["data"]
    session = login_data["SessionTicket"]
    entity_token  = login_data["EntityToken"]["EntityToken"]
    playfab_id = login_data["PlayFabId"]
    entity_type = login_data["EntityToken"]["Entity"]["Type"]
    entity_id = login_data["EntityToken"]["Entity"]["Id"]

    post_to_discord(GameConfig.log_webhook, {
        "content": (
            f"**PlayFab login**\n"
            f"custom id: `{data['CustomId']}`  |  platform: `{data['Platform']}`\n"
            f"playfab id: `{playfab_id}`  |  entity id: `{entity_id}` ({entity_type})"
        ),
        "username": "PlayFab Webhook",
    })
    requests.post(
        url=GameConfig.playfab_url("Server/LinkServerCustomId"),
        json={"ForceLink": True, "PlayFabId": playfab_id, "ServerCustomId": data["CustomId"]},
        headers=GameConfig.auth_headers(),
    )
    return jsonify({
        "playFabId":    playfab_id,
        "sessionTicket": session,
        "entityToken":  entity_token,
        "entityId":     entity_id,
        "entityType":   entity_type,
    }), 200


@app.route("/api/Authentication", methods=["POST"])
def authentication():
    data = request.get_json() or {}
    ticket = data.get("Ticket")
    nonce = data.get("Nonce")
    title = data.get("AppId")
    platform = data.get("Platform")
    org_id = data.get("OrgScopedId")
    custom_id = data.get("CustomId")
    app_version = data.get("AppVersion", "unknown")

    if title != GameConfig.title_id:
        return jsonify({"status": "error", "message": "Invalid app id"}), 403
    if platform != "Android":
        return jsonify({"status": "error", "message": "Invalid platform"}), 403
    if not validate_nonce(nonce, org_id):
        return jsonify({"status": "error", "message": "Invalid nonce"}), 403
    if not custom_id or not custom_id.startswith(("OC", "PI")):
        return jsonify({"status": "error", "message": "Invalid custom id"}), 403

    validation = requests.post(
        url=GameConfig.playfab_url("Server/ValidateSessionTicket"),
        json={"SessionTicket": ticket},
        headers=GameConfig.auth_headers(),
    )

    if validation.status_code != 200:
        return jsonify({"status": "error", "message": "Session ticket invalid"}), 403

    playfab_id = validation.json().get("data", {}).get("UserId", "unknown")

    post_to_discord(GameConfig.log_webhook, {
        "embeds": [{
            "title": "Photon session authenticated",
            "color": 0x00FF99,
            "fields": [
                {"name": "User id",        "value": custom_id,              "inline": True},
                {"name": "App version",    "value": app_version,            "inline": True},
                {"name": "Org scoped id",  "value": org_id or "n/a",        "inline": False},
                {"name": "PlayFab id",     "value": playfab_id,             "inline": True},
                {"name": "Session ticket", "value": ticket[:32] + "...",    "inline": False},
            ],
            "footer": {"text": "photon auth"},
        }],
        "username": "Photon Logs",
    })

    return jsonify({"status": "success", "message": "Session validated"}), 200


